+@contextmanager
+def staged_outputs(args):
+    """Build completely before committing each output with os.replace."""
+    staged = []
+    paths = {field: getattr(args, field) for field in ('output', 'vendor_boot')}
+    try:
+        for field, path in paths.items():
+            if path is None:
+                continue
+            directory = (os.path.dirname(os.path.abspath(path))
+                         if path != '-' else None)
+            stream = tempfile.NamedTemporaryFile(
+                mode='w+b', prefix='.mkbootimg-', dir=directory, delete=False)
+            staged.append((path, stream))
+            setattr(args, field, stream)
+        yield
+        for _, stream in staged:
+            stream.flush()
+            os.fsync(stream.fileno())
+            stream.close()
+        for path, stream in staged:
+            if path == '-':
+                with open(stream.name, 'rb') as image:
+                    shutil.copyfileobj(image, sys.stdout.buffer)
+                sys.stdout.buffer.flush()
+                os.unlink(stream.name)
+            else:
+                os.replace(stream.name, path)
+    finally:
+        for _, stream in staged:
+            stream.close()
+            if os.path.exists(stream.name):
+                os.unlink(stream.name)
+        for field, path in paths.items():
+            setattr(args, field, path)
+
